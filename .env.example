# Copy to .env. Never commit .env -- it is gitignored, keep it that way.

# Bring your own OpenRouter key. One key does three things here: the agent
# inside the container, your proposer calls, and the account-balance reads the
# budget guard uses.
#
# Set a hard per-key spend limit at https://openrouter.ai/settings/keys before
# you use it. The kit's BudgetGuard is a second layer -- it refuses to start a
# rollout past --budget -- but the enforceable boundary should be on the key.
#
# Expect to spend a couple of dollars. A rollout is ~$0.12. See TASK.md "Cost";
# spending more is not a better submission.
OPENROUTER_API_KEY=

# Optional overrides -- the defaults are what the research harness uses.
# QUAL_MODEL=z-ai/glm-5.3-flash          # the frozen agent inside the rollout
# QUAL_PROPOSER_MODEL=z-ai/glm-5.3-flash # the model your loop proposes with
# QUAL_MAX_TURNS=60                      # hard turn cap per rollout
# QUAL_TIMEOUT_S=1500                    # wall-clock cap per container run
# QUAL_BUDGET_USD=5                      # default ceiling for `qual` commands
# QUAL_HARNESS=claude                    # the coding agent: see `qual harnesses`
# QUAL_CONTAINER_BACKEND=enroot          # or docker, if you have the daemon
# QUAL_CONTAINER_IMAGE=geos-eval
# GEOS_SOURCE_DIR=/data/shared/geophysics_agent_data/data/GEOS
